# Groq API key - get key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini API key - get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key - get key at https://platform.openai.com/api-keys
# Anthropic API key - get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API key - get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default provider: "groq", "openrouter", "gemini", "openai", or "anthropic"
MODEL_PROVIDER=groq

# Optional model overrides
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

